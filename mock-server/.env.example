# ============================================
# STTAURX Environment Configuration
# Copy this to .env and fill in your values
# ============================================

# Node Environment
NODE_ENV=development

# Server
PORT=3001
HOST=localhost

# PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://sttaurx_admin:your_password_here@localhost:5432/sttaurx?schema=public"
DATABASE_POOL_SIZE=20
DB_SSL=false
DB_TIMEOUT=30000

# Redis
REDIS_URL="redis://:your_redis_password@localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined

# Gold Price API (optional - for real-time gold prices)
GOLD_API_KEY=
GOLD_API_URL=

# Email Service (optional - for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@sttaurx.io
