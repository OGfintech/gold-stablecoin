{
  "name": "gold-mock-server",
  "version": "2.0.0",
  "description": "STTAURX API Server with PostgreSQL + Redis",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "node database/seeds/seed.js",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:status": "prisma migrate status",
    "setup:local": "npm run db:generate && npm run db:push && npm run db:seed",
    "setup:production": "npm run db:generate && npm run db:migrate:deploy && npm run db:seed"
  },
  "dependencies": {
    "@prisma/client": "^5.9.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^9.0.1",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.3",
    "prisma": "^5.9.0"
  },
  "prisma": {
    "schema": "database/schema.prisma",
    "seed": "node database/seeds/seed.js"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
